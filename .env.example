# ============================================================
# DiagramKG — Environment Variables
# Copy this file to .env and fill in your values.
# ============================================================

# ----- LLM Provider -----
# Choose: "groq" (free, fast), "google" (free tier), or "anthropic" (paid)
LLM_PROVIDER=groq

# ----- Groq — FREE, recommended -----
# Get a free key (no credit card) at: https://console.groq.com/keys
# Free tier: ~14,400 requests/day, blazing fast LPU inference
# Uses Llama 4 Scout which supports vision (diagram images)
GROQ_API_KEY=gsk_your-key-here
GROQ_MODEL=llama-3.2-11b-vision-preview

# ----- Google Gemini — FREE tier (alternative) -----
# Get a free key at: https://aistudio.google.com/apikey  (use AI Studio, not Cloud Console)
GOOGLE_API_KEY=your-gemini-key-here
GEMINI_MODEL=gemini-2.0-flash

# ----- Anthropic Claude — paid -----
# Only needed if LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-your-key-here
CLAUDE_MODEL=claude-sonnet-4-5

# ----- Neo4j -----
# Matches docker-compose.yml defaults
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=diagramkg

# ----- Storage -----
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=20
